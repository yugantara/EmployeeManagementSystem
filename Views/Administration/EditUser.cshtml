@model EditUserViewModel

@{
    ViewBag.Title = "Edit User";
}

<h1 class="mb-4">Edit User</h1>

<form method="post" class="mt-3">
    <div class="row mb-3">
        <label asp-for="Id" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Id" disabled class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="UserName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="City" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="City" class="form-control" />
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row mb-4">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">
                Update
            </button>
            <a asp-action="ListUsers" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">User Roles</h5>
        </div>

        <div class="card-body">
            @if (Model.Roles.Any())
            {
                foreach (var role in Model.Roles)
                {
                    <h6 class="card-title">@role</h6>
                }
            }
            else
            {
                <p class="text-muted mb-0">None at the moment</p>
            }
        </div>

        <div class="card-footer text-start">
            <a asp-action="ManageUserRoles" asp-route-userId="@Model.Id" class="btn btn-primary" style="width: auto">
                Manage Roles
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">User Claims</h5>
        </div>

        <div class="card-body">
            @if (Model.Claims.Any())
            {
                foreach (var claim in Model.Claims)
                {
                    <h6 class="card-title">@claim</h6>
                }
            }
            else
            {
                <p class="text-muted mb-0">None at the moment</p>
            }
        </div>

        <div class="card-footer text-start">
            <a asp-action="ManageUserClaims" asp-route-userId="@Model.Id"
                   style="width:auto" class="btn btn-primary">
                Manage Claims
            </a>
        </div>
    </div>
</form>
