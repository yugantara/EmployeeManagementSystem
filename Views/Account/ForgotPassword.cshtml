@model ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-envelope-exclamation fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1">Forgot Password</h3>
                <p class="text-muted small mb-0">Enter your email and we'll send you a reset link</p>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary text-nowrap w-100">
                            <i class="bi bi-send me-1"></i>Send Reset Link
                        </button>
                        <a asp-controller="account" asp-action="login" class="btn btn-outline-secondary text-nowrap w-100">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>