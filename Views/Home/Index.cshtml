@model IEnumerable<Employee>
@{
    ViewBag.Title = "Employee List";
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 g-md-4">
    @foreach (var employee in Model)
    {
        var photoPath = "~/images/" + (employee.PhotoPath ?? "noimage.jpg");
        <div class="col">
            <div class="card h-100 w-100">

                <div class="card-header">
                    <h3>@employee.Name</h3>
                </div>

                <img asp-append-version="true" class="card-img-top imageThumbnail img-fluid w-100"
                     src="@photoPath"
                     alt="Employee image"
                     style="height: 260px; object-fit: contain; background-color: #f8f9fa;" />

                <div class="card-footer text-center">
                    <a asp-controller="home" asp-action="details" asp-route-id="@employee.Id" class="btn btn-primary m-1">View</a>
                    <a asp-controller="home" asp-action="edit" asp-route-id="@employee.Id" class="btn btn-primary m-1">Edit</a>
                    <a href="#" class="btn btn-danger m-1">Delete</a>
                </div>

            </div>
        </div>
    }
</div>