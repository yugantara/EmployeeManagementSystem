@model EmployeeCreateViewModel
@{
    ViewBag.Title = "Create Employee";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-plus fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">Create Employee</h3>
                        <p class="text-muted small mb-0">Fill in the details to add a new employee</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form enctype="multipart/form-data" asp-controller="home" asp-action="create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-diagram-3"></i></span>
                            <select asp-for="Department" class="form-select"
                                    asp-items="Html.GetEnumSelectList<Dept>()">
                                <option value="">Please Select</option>
                            </select>
                        </div>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Photo" class="form-label fw-medium"></label>
                        <input asp-for="Photo" class="form-control" type="file" accept="image/*" />
                        <div class="form-text">Optional. JPG, PNG or WebP.</div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary text-nowrap d-inline-flex align-items-center justify-content-center" style="min-width: 110px;">Create</button>
                        <a asp-controller="home" asp-action="index" class="btn btn-outline-secondary text-nowrap d-inline-flex align-items-center justify-content-center" style="min-width: 110px;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>