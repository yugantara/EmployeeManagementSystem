@model HomeDetailsViewModel
@{
    ViewBag.Title = "Employee Details";
    var photoPath = "~/images/" + (Model.Employee.PhotoPath ?? "noimage.jpg");
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-0 text-center">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-person fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1">@Model.Employee.Name</h3>
                <p class="text-muted small mb-0">Employee Details</p>
            </div>

            <div class="card-body p-4 text-center">
                <img class="img-thumbnail rounded bg-white mb-4"
                     src="@photoPath"
                     alt="Employee image"
                     asp-append-version="true"
                     style="width: 220px; height: 220px; object-fit: contain;" />

                <div class="text-start bg-light rounded p-3 mb-0">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted small">Employee ID</span>
                        <span class="fw-medium">@Model.Employee.Id</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted small">Email</span>
                        <span class="fw-medium text-break">@Model.Employee.Email</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted small">Department</span>
                        <span class="badge bg-primary-subtle text-primary">@Model.Employee.Department</span>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-0 pb-4">
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="home" asp-action="index" class="btn btn-outline-secondary text-center" style="width: 110px;">Back</a>
                    <a asp-action="edit" asp-controller="home" asp-route-id="@Model.Employee.Id" class="btn btn-primary text-center" style="width: 110px;">Edit</a>
                    <a href="#" class="btn btn-danger text-center" style="width: 110px;">Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>